# ---------------------------------------------------------------------------
# FinSight production settings. On the server:  cp .env.production.example .env
# then fill in the values below. Never commit .env.
# ---------------------------------------------------------------------------

# --- Web / HTTPS -----------------------------------------------------------
# Your server address. With no domain, use the free sslip.io trick:
#   <your-ec2-public-ip>.sslip.io   e.g. 13.233.10.20.sslip.io
# Leave empty to serve plain http on port 80 (local testing).
SITE_ADDRESS=

# --- Site mode -----------------------------------------------------------------
# inspect = visitors can browse the app and saved chats, but no LLM calls (saves credits)
# demo    = everything works (switch to this when you give a live demo)
# Apply a change with:  docker compose -f docker-compose.prod.yml up -d
APP_MODE=inspect
# Shown to visitors in inspect mode
DEMO_CONTACT_EMAIL=harshvardhan.masalge@iiitgn.ac.in

# --- Database ----------------------------------------------------------------
# Any long random string, e.g. output of:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App -----------------------------------------------------------------------
SESSION_SECRET=
NEWSAPI_KEYS=
CORS_ORIGINS=

# --- LLM providers (same as local .env) -----------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Optional fallbacks (leave empty if unused)
GROQ_API_KEYS=
GEMINI_API_KEYS=

# --- Tuning ----------------------------------------------------------------------
# Celery worker processes (each may load FinBERT, ~0.5 GB RAM). 2 suits an 8 GB server.
CELERY_CONCURRENCY=2
