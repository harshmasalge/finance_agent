# FinSight production web server.
#
# SITE_ADDRESS - your domain (e.g. 13.233.10.20.sslip.io). Caddy then gets a free HTTPS
#                certificate automatically. ":80" = plain http on port 80 (local testing).
#
# There is no login: what visitors may do is controlled by APP_MODE (demo | inspect) in
# .env, enforced by the backend.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API + websocket -> FastAPI (the /api prefix is stripped)
	handle_path /api/* {
		reverse_proxy backend:8001 {
			# stream Server-Sent Events (live agent steps) immediately
			flush_interval -1
		}
	}

	# React single-page app
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
