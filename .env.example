POSTGRES_URL=postgresql://postgres:password@localhost:5432/finsight
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=change_this_to_a_random_string
ENVIRONMENT=development
NEWSAPI_KEYS=your_newsapi_key_1,your_newsapi_key_2

# LLM (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_key
LLM_MODEL=openai/gpt-4o-mini

# Default provider for new chats: groq | openrouter | gemini (switchable in the UI)
LLM_PROVIDER=groq
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2
GEMINI_API_KEYS=your_gemini_key

# Knowledge base vector store: embedded (data/chroma) | http (CHROMA_URL)
RAG_CHROMA_MODE=embedded
